{
  "info": {
    "name": "Hospital Appointment API - Appointments",
    "description": "Import this collection into Postman to exercise the appointment lifecycle. Set baseUrl, doctorId, and role-specific tokens before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "patientToken", "value": "", "type": "string" },
    { "key": "doctorToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "doctorId", "value": "66e27ab6f8e8f2378c89b123", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "futureStartAt", "value": "2030-12-02T10:00:00.000Z", "type": "string" }
  ],
  "item": [
    {
      "name": "Appointments",
      "description": "Patient booking and cancellation, doctor status updates, and permitted reads. A booking needs a futureStartAt that falls in the selected doctor's configured working hours.",
      "item": [
        {
          "name": "1. Book Appointment (Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Appointment created', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "if (body.data && body.data._id) { pm.collectionVariables.set('appointmentId', body.data._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor\": \"{{doctorId}}\",\n  \"startsAt\": \"{{futureStartAt}}\"\n}"
            },
            "url": "{{baseUrl}}/api/appointments"
          }
        },
        {
          "name": "2. Book Appointment (Past Time - 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor\": \"{{doctorId}}\",\n  \"startsAt\": \"2020-01-01T10:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/appointments"
          }
        },
        {
          "name": "3. List My Appointments (Patient or Doctor)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/api/appointments/my?page=1&limit=10"
          }
        },
        {
          "name": "4. List All Appointments (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/appointments?page=1&limit=10"
          }
        },
        {
          "name": "5. Get Appointment by ID (Permitted User)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "6. Confirm Appointment (Doctor)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Confirmed\"\n}"
            },
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/status"
          }
        },
        {
          "name": "7. Cancel Appointment (Patient)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel"
          }
        },
        {
          "name": "8. Get Appointment (Invalid ID - 400)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/api/appointments/invalid-id"
          }
        }
      ]
    }
  ]
}
