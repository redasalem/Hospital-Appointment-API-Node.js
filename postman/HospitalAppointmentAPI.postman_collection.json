{
  "info": {
    "_postman_id": "cf86c76a-3431-4881-a655-13b35448521c",
    "name": "Hospital Appointment API",
    "description": "Complete API collection. Register patient and doctor accounts, log in all required roles, then create the doctor profile and appointment in order. Login and create requests save tokens and IDs automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "patientEmail", "value": "" },
    { "key": "patientPassword", "value": "SecurePass123!" },
    { "key": "doctorEmail", "value": "" },
    { "key": "doctorPassword", "value": "SecurePass123!" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "patientToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "doctorUserId", "value": "" },
    { "key": "doctorId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "futureAppointmentTime", "value": "2030-06-17T09:00:00.000Z" }
  ],
  "event": [{
    "listen": "prerequest",
    "script": {
      "type": "text/javascript",
      "exec": [
        "const suffix = Date.now();",
        "if (!pm.collectionVariables.get('patientEmail')) pm.collectionVariables.set('patientEmail', 'patient-' + suffix + '@example.com');",
        "if (!pm.collectionVariables.get('doctorEmail')) pm.collectionVariables.set('doctorEmail', 'doctor-' + suffix + '@example.com');"
      ]
    }
  }],
  "item": [
    {
      "name": "Health",
      "item": [{
        "name": "Health Check",
        "request": { "method": "GET", "url": "{{baseUrl}}/health" },
        "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));"] } }]
      }]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Patient",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"name\": \"Postman Patient\",\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\",\n  \"role\": \"patient\"\n}"}, "url": "{{baseUrl}}/api/auth/register" },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('patientToken', pm.response.json().token);"]}}]
        },
        {
          "name": "Register Doctor Account",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"name\": \"Dr. Postman\",\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\",\n  \"role\": \"doctor\"\n}"}, "url": "{{baseUrl}}/api/auth/register" },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('created', () => pm.response.to.have.status(201));","const b = pm.response.json(); pm.collectionVariables.set('doctorToken', b.token); pm.collectionVariables.set('doctorUserId', b.data._id);"]}}]
        },
        {
          "name": "Login Patient",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}"}, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('logged in', () => pm.response.to.have.status(200));","pm.collectionVariables.set('patientToken', pm.response.json().token);"]}}]
        },
        {
          "name": "Login Doctor",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{doctorPassword}}\"\n}"}, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('logged in', () => pm.response.to.have.status(200));","const b = pm.response.json(); pm.collectionVariables.set('doctorToken', b.token); pm.collectionVariables.set('doctorUserId', b.data._id);"]}}]
        },
        {
          "name": "Login Admin",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"}, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('admin logged in', () => pm.response.to.have.status(200));","pm.collectionVariables.set('adminToken', pm.response.json().token);"]}}]
        },
        { "name": "Get Current User", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{patientToken}}"}], "url": "{{baseUrl}}/api/auth/me" } },
        { "name": "Logout Patient (run last)", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{patientToken}}"}], "url": "{{baseUrl}}/api/auth/logout" } }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create Doctor Profile (Admin)",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{adminToken}}"}], "body": {"mode":"raw","raw":"{\n  \"user\": \"{{doctorUserId}}\",\n  \"name\": \"Dr. Postman\",\n  \"specialization\": \"Cardiology\",\n  \"phone\": \"+1-555-0199\",\n  \"workingHours\": [{ \"day\": \"Monday\", \"startTime\": \"09:00\", \"endTime\": \"17:00\" }]\n}"}, "url": "{{baseUrl}}/api/doctors" },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('profile created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('doctorId', pm.response.json().data._id);"]}}]
        },
        { "name": "List Doctors", "request": { "method": "GET", "url": "{{baseUrl}}/api/doctors?page=1&limit=10" } },
        { "name": "Search Doctors", "request": { "method": "GET", "url": "{{baseUrl}}/api/doctors?specialization=Cardiology&search=Postman&page=1&limit=10" } },
        { "name": "Get Doctor by ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/doctors/{{doctorId}}" } },
        { "name": "Update Doctor Profile (Admin)", "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{adminToken}}"}], "body": {"mode":"raw","raw":"{ \"description\": \"Updated through Postman.\" }"}, "url": "{{baseUrl}}/api/doctors/{{doctorId}}" } },
        { "name": "Delete Doctor Profile (Admin, run last)", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{baseUrl}}/api/doctors/{{doctorId}}" } }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book Appointment (Patient)",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{patientToken}}"}], "body": {"mode":"raw","raw":"{\n  \"doctor\": \"{{doctorId}}\",\n  \"startsAt\": \"{{futureAppointmentTime}}\",\n  \"reason\": \"Annual check-up\"\n}"}, "url": "{{baseUrl}}/api/appointments" },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('appointment created', () => pm.response.to.have.status(201));","pm.collectionVariables.set('appointmentId', pm.response.json().data._id);"]}}]
        },
        { "name": "List My Appointments (Patient)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{patientToken}}"}], "url": "{{baseUrl}}/api/appointments/my?page=1&limit=10" } },
        { "name": "Get Appointment by ID (Patient)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{patientToken}}"}], "url": "{{baseUrl}}/api/appointments/{{appointmentId}}" } },
        { "name": "List My Appointments (Doctor)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{doctorToken}}"}], "url": "{{baseUrl}}/api/appointments/my?page=1&limit=10" } },
        { "name": "Confirm Appointment (Doctor)", "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{doctorToken}}"}], "body": {"mode":"raw","raw":"{ \"status\": \"Confirmed\" }"}, "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/status" } },
        { "name": "List All Appointments (Admin)", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{baseUrl}}/api/appointments?page=1&limit=10" } },
        { "name": "Cancel Appointment (Patient)", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{patientToken}}"}], "url": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel" } }
      ]
    },
    {
      "name": "AI",
      "item": [{
        "name": "Summarize Symptoms (Patient)",
        "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{patientToken}}"}], "body": {"mode":"raw","raw":"{\n  \"symptoms\": \"Persistent cough and mild fever for three days.\",\n  \"description\": \"Symptoms worsen at night.\"\n}"}, "url": "{{baseUrl}}/api/ai/summarize-symptoms" }
      }]
    }
  ]
}
